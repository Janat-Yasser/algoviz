<% const first = (d) => d.split(/(?<=\.)\s/)[0]; %>
<% const o = (s) => s.includes('n²') ? 'o-bad' : (s.includes('log') ? 'o-good' : ''); %>
<section class="hero">
  <h1 class="hero-title">Watch an algorithm think.</h1>
  <p class="hero-sub">Every comparison, swap and explored square, drawn out one step at a time next to the line of code doing it. Sorting, pathfinding and binary search trees, with sound if you want to hear them work.</p>
  <div class="hero-actions">
    <a href="/sorting/quick" class="btn-primary">Open the sorting bench</a>
    <a href="/race" class="btn-ghost">Race sorts against each other</a>
  </div>
</section>

<section class="bench" aria-label="A sort running live">
  <div class="bench-head">
    <strong id="heroName">Quick sort</strong>
    <span class="count">comparisons <b id="heroCmp">0</b></span>
    <span class="count">swaps <b id="heroSwp">0</b></span>
    <button class="btn-control" data-sound-toggle aria-pressed="false">Sound off</button>
    <button class="btn-control" id="heroNext">Next algorithm</button>
  </div>
  <div class="bars-container" id="heroBars" data-nolabels="1"></div>
</section>

<section class="toc">
  <div class="toc-group">
    <h2>Sorting</h2>
    <p>Six ways to put numbers in order, from the ones you'd invent yourself to the ones libraries use.</p>
    <ul class="toc-list">
      <% sorting.forEach(a => { %>
        <li><a href="/sorting/<%= a.id %>">
          <span class="toc-name"><span class="swatch" style="background:<%= a.color %>"></span><%= a.name %></span>
          <span class="toc-desc"><%= first(a.description) %></span>
          <span class="toc-o"><%= a.complexity.time.average %></span>
        </a></li>
      <% }) %>
    </ul>
  </div>

  <div class="toc-group">
    <h2>Pathfinding</h2>
    <p>Draw walls on a grid and watch four searches look for the way through, then compare them on the same maze.</p>
    <ul class="toc-list">
      <% pathfinding.forEach(a => { %>
        <li><a href="/pathfinding?algo=<%= a.id %>">
          <span class="toc-name"><span class="swatch" style="background:<%= a.color %>"></span><%= a.name %></span>
          <span class="toc-desc"><%= first(a.description) %></span>
          <span class="toc-o"><%= a.complexity.time.average %></span>
        </a></li>
      <% }) %>
    </ul>
  </div>

  <div class="toc-group">
    <h2>Trees</h2>
    <p>Grow a binary search tree, search it, delete from it, and walk it in three orders.</p>
    <ul class="toc-list">
      <% trees.forEach(a => { %>
        <li><a href="/trees">
          <span class="toc-name"><span class="swatch" style="background:<%= a.color %>"></span><%= a.name %></span>
          <span class="toc-desc"><%= first(a.description) %></span>
          <span class="toc-o"><%= a.complexity.time.average %></span>
        </a></li>
      <% }) %>
    </ul>
  </div>
</section>

<section class="cheatsheet">
  <h2>Sorting at a glance</h2>
  <div class="sheet-wrap"><table class="sheet">
    <thead><tr><th>Algorithm</th><th>Best</th><th>Average</th><th>Worst</th><th>Extra space</th><th>Stable</th></tr></thead>
    <tbody>
      <% sorting.forEach(a => { %>
        <tr>
          <td><a href="/sorting/<%= a.id %>"><%= a.name %></a></td>
          <td class="<%= o(a.complexity.time.best) %>"><%= a.complexity.time.best %></td>
          <td class="<%= o(a.complexity.time.average) %>"><%= a.complexity.time.average %></td>
          <td class="<%= o(a.complexity.time.worst) %>"><%= a.complexity.time.worst %></td>
          <td><%= a.complexity.space %></td>
          <td><%= a.stable ? 'yes' : 'no' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
</section>

<footer class="foot">Built with Express and plain JavaScript. Every animation is generated from the real algorithm, step by step.</footer>

<script src="/js/sound.js"></script>
<script src="/js/algorithms/sorting.js"></script>
<script src="/js/hero.js"></script>
