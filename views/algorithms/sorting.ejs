<div class="viz-page">
  <aside class="viz-sidebar">
    <div class="sidebar-head">
      <a href="/" class="back-link">Home</a>
      <h3>Sorting</h3>
    </div>
    <nav class="algo-nav">
      <% allAlgos.forEach(a => { %>
        <a href="/sorting/<%= a.id %>" class="algo-nav-item <%= a.id === algo.id ? 'active' : '' %>">
          <span><%= a.name %></span>
          <span class="nav-complexity"><%= a.complexity.time.average %></span>
        </a>
      <% }) %>
    </nav>

    <% const o = (s) => s.includes('n²') ? 'bad' : (s.includes('log') || s === 'O(n)') ? 'good' : 'ok'; %>
    <div class="complexity-panel">
      <h4>Complexity</h4>
      <div class="complexity-grid">
        <div class="c-item"><span class="c-label">Best</span><span class="c-val c-<%= o(algo.complexity.time.best) %>"><%= algo.complexity.time.best %></span></div>
        <div class="c-item"><span class="c-label">Average</span><span class="c-val c-<%= o(algo.complexity.time.average) %>"><%= algo.complexity.time.average %></span></div>
        <div class="c-item"><span class="c-label">Worst</span><span class="c-val c-<%= o(algo.complexity.time.worst) %>"><%= algo.complexity.time.worst %></span></div>
        <div class="c-item"><span class="c-label">Extra space</span><span class="c-val c-ok"><%= algo.complexity.space %></span></div>
      </div>
      <p class="stability-badge"><%= algo.stable ? 'Stable: equal values keep their order.' : 'Not stable: equal values can swap order.' %></p>
    </div>

    <div class="use-cases-panel">
      <h4>Good for</h4>
      <p><%= algo.useCases %></p>
      <p style="margin-top:12px"><a href="/race?algos=<%= algo.id %>,<%= algo.id === 'quick' ? 'merge' : 'quick' %>">Race it against <%= algo.id === 'quick' ? 'merge' : 'quick' %> sort</a></p>
    </div>
  </aside>

  <div class="viz-main">
    <div class="viz-header">
      <h1 class="viz-title"><%= algo.name %></h1>
      <p class="viz-desc"><%= algo.description %></p>
    </div>

    <div class="controls-bar">
      <div class="controls-left">
        <button id="btnPlay" class="btn-control btn-play" onclick="startSort()">Play</button>
        <button id="btnPause" class="btn-control" onclick="pauseSort()" disabled>Pause</button>
        <button id="btnStep" class="btn-control" onclick="stepSort()">Step</button>
        <button id="btnReset" class="btn-control" onclick="resetSort()">Reset</button>
        <button class="btn-control" onclick="shuffleArray()">New numbers</button>
        <button class="btn-control" data-sound-toggle aria-pressed="false">Sound off</button>
      </div>
      <div class="controls-right">
        <div class="control-group">
          <label for="inputSel">Input</label>
          <select id="inputSel" class="input-select" onchange="updateInput(this.value)">
            <option value="random">Random</option>
            <option value="nearly">Nearly sorted</option>
            <option value="reversed">Reversed</option>
            <option value="few">Few distinct values</option>
          </select>
        </div>
        <div class="control-group">
          <label for="sizeSlider">Size <span id="sizeVal">30</span></label>
          <input type="range" id="sizeSlider" min="8" max="80" value="30" oninput="updateSize(this.value)">
        </div>
        <div class="control-group">
          <label for="speedSlider">Speed <span id="speedVal">5</span></label>
          <input type="range" id="speedSlider" min="1" max="10" value="5" oninput="updateSpeed(this.value)">
        </div>
      </div>
    </div>

    <div class="stats-bar">
      <div class="stat-pill">Comparisons <strong id="statComparisons">0</strong></div>
      <div class="stat-pill">Swaps <strong id="statSwaps">0</strong></div>
      <div class="stat-pill">Array reads <strong id="statAccesses">0</strong></div>
      <div class="stat-pill">Time <strong id="statTime">0ms</strong></div>
      <div class="stat-pill status-pill" id="statusPill">Ready</div>
    </div>

    <div class="viz-canvas" id="vizCanvas">
      <div class="bars-container" id="barsContainer"></div>
    </div>

    <div class="legend">
      <div class="legend-item"><span class="legend-dot" style="background:#fff"></span>Not yet placed</div>
      <div class="legend-item"><span class="legend-dot" style="background:var(--hl-yellow)"></span>Comparing</div>
      <div class="legend-item"><span class="legend-dot" style="background:var(--hl-pink)"></span>Swapping</div>
      <div class="legend-item"><span class="legend-dot" style="background:var(--pencil)"></span>Pivot</div>
      <div class="legend-item"><span class="legend-dot" style="background:var(--hl-cyan)"></span>Being merged</div>
      <div class="legend-item"><span class="legend-dot" style="background:var(--hl-green)"></span>In its final place</div>
    </div>

    <div class="explanation-box" id="explanationBox">
      <div id="explanationText">Press <strong>Play</strong> or <strong>Step</strong> to start. Space plays and pauses, the right arrow steps, R gives new numbers.</div>
    </div>

    <div class="code-panel">
      <div class="code-panel-header">
        <span class="code-panel-title"><%= algo.name %> in JavaScript</span>
        <span class="code-hint">The highlighted line is the one running</span>
      </div>
      <div class="code-body">
        <pre class="code-pre" id="codeDisplay"><code id="codeLines"></code></pre>
      </div>
    </div>
  </div>
</div>

<script>
  const ALGO_ID = '<%= algo.id %>';
</script>
<script src="/js/sound.js"></script>
<script src="/js/algorithms/sorting.js"></script>
