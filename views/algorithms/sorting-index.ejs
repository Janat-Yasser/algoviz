<% const first = (d) => d.split(/(?<=\.)\s/)[0]; %>
<section class="toc" style="padding-top:48px">
  <div class="toc-group">
    <h2>Sorting</h2>
    <p>Pick one to step through, or <a href="/race">race several on the same numbers</a>.</p>
    <ul class="toc-list">
      <% algorithms.forEach(a => { %>
        <li><a href="/sorting/<%= a.id %>">
          <span class="toc-name"><span class="swatch" style="background:<%= a.color %>"></span><%= a.name %></span>
          <span class="toc-desc"><%= first(a.description) %></span>
          <span class="toc-o"><%= a.complexity.time.average %></span>
        </a></li>
      <% }) %>
    </ul>
  </div>
</section>
